# Web App Starter Kit
# Copy to .env.local, or run ./setup.sh to configure Convex and Clerk.

# Convex writes these when you run `pnpm exec convex dev`.
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Clerk keys: https://dashboard.clerk.com/last-active?path=api-keys
# Prefer `pnpm setup:clerk`; do not run `clerk init` in this wired starter.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# These paths match app/(auth) and the protected dashboard.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Optional defense against subdomain cookie leaking. Use a comma-separated list
# containing every legitimate local, preview, and production origin.
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://your-app.vercel.app

# Sentry is inert when the public DSN is absent.
# Project settings: https://sentry.io/settings/projects/
# NEXT_PUBLIC_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0

# Build-only credentials for uploading source maps on Vercel. Keep these secret.
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project

# Convex environment (not .env.local): Clerk's Frontend API URL / JWT issuer.
# Set by `pnpm setup:clerk`, or manually:
# pnpm exec convex env set CLERK_JWT_ISSUER_DOMAIN https://your-app.clerk.accounts.dev

# Optional: test a separately running deployment instead of Playwright's local server.
# PLAYWRIGHT_BASE_URL=https://your-preview.vercel.app

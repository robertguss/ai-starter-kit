#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

command -v node >/dev/null 2>&1 || {
  echo "Node.js 24 or newer is required but was not found." >&2
  exit 1
}

node -e 'if (Number(process.versions.node.split(".")[0]) < 24) process.exit(1)' || {
  echo "Node.js 24 or newer is required; found $(node --version)." >&2
  exit 1
}

if ! command -v pnpm >/dev/null 2>&1; then
  if command -v corepack >/dev/null 2>&1; then
    corepack enable
    corepack prepare pnpm@11 --activate
  else
    npm install --global pnpm@11
  fi
fi

pnpm_version="$(pnpm --version)"
if [[ "${pnpm_version%%.*}" != "11" ]]; then
  echo "pnpm 11.x is required; found $pnpm_version." >&2
  exit 1
fi

pnpm install --frozen-lockfile

echo "Orb setup complete. Link Convex and Clerk only when live services are needed."

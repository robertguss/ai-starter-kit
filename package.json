{
  "name": "web-app-starter-kit",
  "version": "1.0.0",
  "description": "A production-ready Next.js starter kit with Convex, Clerk, TypeScript, Tailwind CSS, and shadcn/ui.",
  "author": "Robert Guss <https://github.com/robertguss>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/robertguss/web-app-starter-kit.git"
  },
  "bugs": {
    "url": "https://github.com/robertguss/web-app-starter-kit/issues"
  },
  "homepage": "https://github.com/robertguss/web-app-starter-kit#readme",
  "keywords": [
    "nextjs",
    "react",
    "vercel",
    "convex",
    "clerk",
    "authentication",
    "typescript",
    "shadcn-ui",
    "tailwindcss",
    "starter-kit",
    "boilerplate",
    "full-stack",
    "real-time",
    "serverless"
  ],
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "setup": "bash setup.sh",
    "setup:clerk": "bash scripts/setup-clerk-auth.sh",
    "dev": "pnpm run --parallel \"/^dev:(frontend|backend)$/\"",
    "dev:frontend": "next dev",
    "dev:backend": "convex dev",
    "predev": "convex dev --until-success",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:once && pnpm test:setup",
    "test": "vitest",
    "test:once": "vitest run",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:setup": "bash scripts/check-clerk-setup-wiring.sh",
    "codegen": "convex codegen",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@clerk/nextjs": "^7.8.2",
    "@sentry/nextjs": "^10.71.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "convex-helpers": "^0.1.123",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@clerk/eslint-plugin": "0.2.0",
    "@convex-dev/eslint-plugin": "^4.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@next/env": "16.3.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "convex-test": "^0.0.56",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}

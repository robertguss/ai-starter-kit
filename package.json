{
  "name": "ai-starter-kit",
  "version": "1.0.0",
  "description": "A modern, production-ready starter kit for building full-stack applications with TanStack Start, Convex real-time database, Clerk authentication, TypeScript, and shadcn/ui components.",
  "author": "Robert Guss <https://github.com/robertguss>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/robertguss/ai-starter-kit.git"
  },
  "bugs": {
    "url": "https://github.com/robertguss/ai-starter-kit/issues"
  },
  "homepage": "https://github.com/robertguss/ai-starter-kit#readme",
  "keywords": [
    "tanstack-start",
    "tanstack-router",
    "react19",
    "convex",
    "clerk",
    "authentication",
    "typescript",
    "shadcn-ui",
    "tailwindcss",
    "starter-kit",
    "boilerplate",
    "full-stack",
    "real-time",
    "serverless"
  ],
  "private": false,
  "type": "module",
  "scripts": {
    "setup": "bash setup.sh",
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite dev",
    "dev:backend": "convex dev",
    "predev": "convex dev --until-success && convex dashboard",
    "build": "vite build && tsc --noEmit",
    "start": "srvx --prod -s ../client dist/server/server.js",
    "preview": "vite preview",
    "lint": "eslint",
    "test": "vitest",
    "test:once": "vitest run",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.4.20",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@tabler/icons-react": "^3.37.1",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.28",
    "@tanstack/react-table": "^8.21.3",
    "@vitejs/plugin-react": "^6.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.37.0",
    "convex-helpers": "^0.1.114",
    "lucide-react": "^1.14.0",
    "next-themes": "^0.4.6",
    "npm-run-all2": "^8.0.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-is": "^19.2.8",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "srvx": "^0.11.22",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "vite": "^8.1.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-devtools": "^1.167.0",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "convex-test": "^0.0.51",
    "eslint": "^10.3.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
